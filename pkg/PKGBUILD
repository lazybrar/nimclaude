# Generated by cratepkg 0.2.0. Run `makepkg -si` to build and install, or `makepkg -f` to only build.
pkgname=nimclaude
pkgver=0.1.0
pkgrel=1
pkgdesc='Use NVIDIA NIM chat-completions models in Claude Code via a local Anthropic-compatible proxy'
arch=('x86_64' 'aarch64')
url='https://github.com/lazybrar/nimclaude'
license=('GPL-2.0-or-later')
depends=('gcc-libs' 'glibc')
makedepends=('cargo')
options=('!debug' '!lto')

prepare() {
  cd "$startdir/.."
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$startdir/.."
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release
}

check() {
  cd "$startdir/.."
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --frozen --release
}

package() {
  install -Dm755 "$srcdir/target/release/nimclaude" "$pkgdir/usr/bin/nimclaude"
  install -Dm644 "$startdir/nimclaude.service" "$pkgdir/usr/lib/systemd/user/nimclaude.service"
  install -Dm644 "$startdir/env.example" "$pkgdir/usr/share/doc/$pkgname/env.example"
  install -Dm644 "$startdir/../README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$startdir/../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
